{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "GeminiSettings": {
        "ApiKey": "YOUR_GEMINI_API_KEY_HERE"
    },
    "Jwt": {
        "SecretKey": "YOUR_SECRET_JWT_KEY_MIN_32_CHARS",
        "Issuer": "https://localhost:7191/",
        "Audience": "https://localhost:7191/"
    },
    "ConnectionStrings": {
        "database-work": "Server=YOUR_WORK_SERVER;Database=YOUR_DB;Trusted_Connection=True;TrustServerCertificate=True;",
        "database-home": "Server=YOUR_HOME_SERVER;Database=YOUR_DB;Trusted_Connection=True;TrustServerCertificate=True;"
    }
}